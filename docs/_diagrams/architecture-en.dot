digraph architecture {
  graph [rankdir=TB, splines=ortho, nodesep=0.50, ranksep=0.55, pad=0.20,
         newrank=true, fontname="Helvetica", bgcolor="white",
         label="Green: user entry · Purple: agent · Magenta: services · Gray: environments. Solid arrow: call · dashed: input · double arrow: shared connection.", labelloc="b", labeljust="l", fontsize=10,
         fontcolor="#4b5563"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
        margin="0.16,0.09", penwidth=1.2];
  edge [color="#7c889a", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
        fontsize=10.5, fontcolor="#4b5563"];

  subgraph cluster_user {
    label="User"; labeljust="l"; labelloc="t";
    fontsize=14; margin=14;
    fontcolor="#3f6b1f"; style="rounded,filled";
    fillcolor="#eef7e666"; color="#a5cc7f";
{rank=same; dashboard; cli;}
  dashboard [label=<<FONT POINT-SIZE="13"><B>Web Dashboard</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">Session · TaskRun · SSE</FONT>>, fillcolor="#eef7e6", color="#a5cc7f"];
  cli [label=<<FONT POINT-SIZE="13"><B>CLI / TUI</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">rpent --robot &lt;name&gt;</FONT>>, fillcolor="#eef7e6", color="#a5cc7f"];
  }

  subgraph cluster_agent {
    label="Agent"; labeljust="l"; labelloc="t";
    fontsize=14; margin=14;
    fontcolor="#4527a0"; style="rounded,filled";
    fillcolor="#ede7f666"; color="#9575cd";
{rank=same; prompts; planner; toolkit; memory;}
  prompts [label=<<FONT POINT-SIZE="13"><B>Prompts</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">system · user templates</FONT>>, fillcolor="#ede7f6", color="#9575cd"];
  planner [label=<<FONT POINT-SIZE="13"><B>Planner</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">api · claude_code · codex · flash</FONT>>, fillcolor="#ede7f6", color="#9575cd"];
  toolkit [label=<<FONT POINT-SIZE="13"><B>Toolkit</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">tool schemas · dispatch · ToolResult</FONT>>, fillcolor="#ede7f6", color="#9575cd", group=spine];
  memory [label=<<FONT POINT-SIZE="13"><B>MemoryManager</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">read · merge · index</FONT>>, fillcolor="#ede7f6", color="#9575cd"];
  }

  subgraph cluster_service {
    label="Model and environment services"; labeljust="l"; labelloc="b";
    fontsize=14; margin=14;
    fontcolor="#8e24aa"; style="rounded,filled";
    fillcolor="#fce4f266"; color="#ce93d8";
{rank=same; vla; perception; env_service;}
  vla [label=<<FONT POINT-SIZE="13"><B>VLA / WAM service</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">Pi0.5 · RLDX-1 · LingBot-VLA<BR/>VPP2 · Awomo05</FONT>>, fillcolor="#fce4f2", color="#ce93d8"];
  perception [label=<<FONT POINT-SIZE="13"><B>Perception service</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">SAM3 · Molmo2<BR/>(Flash localization)</FONT>>, fillcolor="#fce4f2", color="#ce93d8"];
  env_service [label=<<FONT POINT-SIZE="13"><B>Environment service</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">simulator or robot connection</FONT>>, fillcolor="#fce4f2", color="#ce93d8", group=spine];
  }

  subgraph cluster_env {
    label="Environments"; labeljust="l"; labelloc="t";
    fontsize=14; margin=14;
    fontcolor="#455a64"; style="rounded,filled";
    fillcolor="#eceff166"; color="#b0bec5";
{rank=same; sims; real;}
  sims [label=<<FONT POINT-SIZE="13"><B>Simulators</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">LIBERO · RoboCasa365<BR/>RoboTwin · RoboDojo</FONT>>, fillcolor="#eceff1", color="#b0bec5"];
  real [label=<<FONT POINT-SIZE="13"><B>Real robots</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">Franka · Dual-Arm Franka · YAM</FONT>>, fillcolor="#eceff1", color="#b0bec5"];
  }

  dashboard -> planner [xlabel="task"];
  cli -> planner [xlabel="task"];
  prompts -> planner [style=dashed];
  planner -> toolkit;
  toolkit -> memory [dir=both, xlabel="memory"];
  toolkit -> vla [xlabel="action"];
  toolkit -> perception;
  toolkit -> env_service [xlabel="state"];
  env_service -> sims [dir=both, xlabel="connection"];
  env_service -> real [dir=both, xlabel="connection"];
}
