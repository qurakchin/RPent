digraph flow {
  graph [rankdir=TB, splines=spline, nodesep=0.30, ranksep=0.30, pad=0.15,
         fontname="Helvetica", bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
        margin="0.16,0.09", penwidth=1.2, fillcolor="#eaf1fd",
        color="#93b4f0"];
  edge [color="#7c889a", penwidth=1.3, arrowsize=0.7, fontname="Helvetica",
        fontsize=10.5, fontcolor="#4b5563"];

  f_cli [label=<<FONT POINT-SIZE="13"><B>CLI</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">load RobotSpec · parse RunConfig</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_session [label=<<FONT POINT-SIZE="13"><B>Session / TaskRun</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">memory sync · planner · prompts</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_services [label=<<FONT POINT-SIZE="13"><B>Runtime services</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">VLA · perception · environment</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_loop [label=<<FONT POINT-SIZE="13"><B>Planner loop</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">list_tools → execute_tool → ToolResult</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_end [label=<<FONT POINT-SIZE="13"><B>Planner stops</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">finish · turn limit · error</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_result [label=<<FONT POINT-SIZE="13"><B>Run artifacts</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">episode.mp4 · transcript · run.log</FONT>>, fillcolor="#eaf1fd", color="#93b4f0"];
  f_cli -> f_session;
  f_session -> f_services;
  f_services -> f_loop [label="Observation"];
  f_loop -> f_end;
  f_end -> f_result;
  {rank=same; f_loop; f_fail;}
  f_loop -> f_fail [dir=both, label="error / timeout", style=dashed,
                    constraint=false];
  f_note [label="Success is decided by the environment or the robot operator, not by finish.", shape=note, style="filled",
          fillcolor="#fff8e1", color="#e0c36b", fontsize=10, margin="0.12,0.08",
          penwidth=1.0];
  f_end -> f_note [style=dotted, arrowhead=none];
  f_fail [label=<<FONT POINT-SIZE="13"><B>Tool failure / timeout</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4b5563">error returned to the planner</FONT>>, fillcolor="#fef3e2", color="#d9a05b"];
}
